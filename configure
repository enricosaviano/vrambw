#!/bin/sh
# vrambw configure: finds C++ compiler and (optionally) nvcc, writes config.mk
#
#   ./configure                         auto-detect (no nvcc -> RAM-only build)
#   ./configure --cuda=/usr/local/cuda-11.4
#   ./configure --nvcc=/opt/cuda/bin/nvcc --arch=61,86
#   ./configure --host-cxx=g++-10       C++ compiler (also host compiler for nvcc)
#   ./configure --without-cuda          RAM-only build

CUDA_DIR=""
NVCC=""
ARCHS=""
HOSTCXX=""
EXTRA=""
WITH_CUDA=auto

usage() {
    cat <<EOF
usage: ./configure [options]
  --cuda=DIR                    CUDA toolkit directory (contains bin/nvcc)
  --nvcc=PATH                   explicit nvcc path
  --without-cuda                build only the RAM test
  --arch=LIST                   compute capabilities, e.g. 61 or 61,86 (default: all supported)
  --host-cxx=CXX                C++ compiler (also host compiler for nvcc), e.g. g++-10
  --allow-unsupported-compiler  pass -allow-unsupported-compiler to nvcc
EOF
    exit 0
}

for arg in "$@"; do
    case "$arg" in
        --cuda=*)     CUDA_DIR="${arg#*=}"; WITH_CUDA=yes ;;
        --nvcc=*)     NVCC="${arg#*=}"; WITH_CUDA=yes ;;
        --without-cuda) WITH_CUDA=no ;;
        --arch=*)     ARCHS=$(echo "${arg#*=}" | tr ',' ' ') ;;
        --host-cxx=*) HOSTCXX="${arg#*=}" ;;
        --allow-unsupported-compiler) EXTRA="$EXTRA -allow-unsupported-compiler" ;;
        -h|--help)    usage ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

# --- C++ compiler
CXX="$HOSTCXX"
if [ -z "$CXX" ]; then
    for c in g++ c++ clang++; do
        if command -v $c >/dev/null 2>&1; then CXX=$c; break; fi
    done
fi
[ -z "$CXX" ] && { echo "C++ compiler not found (install g++ or use --host-cxx=)" >&2; exit 1; }
printf '#include <thread>\nint main(){std::thread t([]{});t.join();return 0;}\n' > "$T/t.cpp"
if ! $CXX -O2 -std=c++14 -pthread -o "$T/t" "$T/t.cpp" > "$T/log" 2>&1; then
    cat "$T/log" >&2
    echo "C++ compiler '$CXX' does not work" >&2
    exit 1
fi
echo "c++:       $(command -v $CXX)"

# --- nvcc
if [ "$WITH_CUDA" != no ] && [ -z "$NVCC" ]; then
    for c in "$CUDA_DIR" "$CUDA_HOME" "$CUDA_PATH"; do
        if [ -n "$c" ] && [ -x "$c/bin/nvcc" ]; then NVCC="$c/bin/nvcc"; break; fi
    done
    [ -z "$NVCC" ] && NVCC=$(command -v nvcc 2>/dev/null)
    if [ -z "$NVCC" ]; then
        for c in /usr/local/cuda /opt/cuda $(ls -d /usr/local/cuda-* 2>/dev/null | sort -V -r); do
            if [ -x "$c/bin/nvcc" ]; then NVCC="$c/bin/nvcc"; break; fi
        done
    fi
fi
if [ "$WITH_CUDA" != no ] && { [ -z "$NVCC" ] || [ ! -x "$NVCC" ]; }; then
    if [ "$WITH_CUDA" = yes ]; then
        echo "nvcc not found (${NVCC:-$CUDA_DIR/bin/nvcc})" >&2
        exit 1
    fi
    WITH_CUDA=no
    echo "nvcc:      not found -> building without CUDA (RAM test only)"
fi

if [ "$WITH_CUDA" = no ]; then
    cat > config.mk <<EOF
# generated by ./configure - can be edited by hand
HAVE_CUDA = 0
CXX       = $CXX
CXXFLAGS  = -O3 -std=c++14 -pthread -Wall
EOF
    echo "wrote config.mk. Now run: make && ./vrambw"
    exit 0
fi

[ -z "$CUDA_DIR" ] && CUDA_DIR=$(dirname "$(dirname "$NVCC")")
VER=$("$NVCC" --version | sed -n 's/.*release \([0-9]*\.[0-9]*\).*/\1/p')
MAJ=${VER%%.*}
MIN=${VER#*.}
echo "nvcc:      $NVCC (CUDA $VER)"

# --- archs
if [ -z "$ARCHS" ]; then
    SUPPORTED=$("$NVCC" --list-gpu-arch 2>/dev/null | sed -n 's/^compute_\([0-9]*\)$/\1/p')
    if [ -z "$SUPPORTED" ]; then
        if [ "$MAJ" -ge 12 ] && [ "$MIN" -ge 8 ]; then SUPPORTED="50 52 60 61 70 75 80 86 89 90 100 120"
        elif [ "$MAJ" -ge 12 ]; then SUPPORTED="50 52 60 61 70 75 80 86 89 90"
        elif [ "$MAJ" -eq 11 ] && [ "$MIN" -ge 8 ]; then SUPPORTED="35 50 52 60 61 70 75 80 86 89 90"
        else SUPPORTED="35 50 52 60 61 70 75 80 86"
        fi
    fi
    WANT="35 37 50 52 60 61 70 75 80 86 89 90 100 120"
    for a in $WANT; do
        for s in $SUPPORTED; do [ "$a" = "$s" ] && ARCHS="$ARCHS $a"; done
    done
fi
ARCHS=$(echo $ARCHS)
[ -z "$ARCHS" ] && { echo "no valid GPU architecture" >&2; exit 1; }

GENCODE=""
LAST=""
for a in $ARCHS; do
    GENCODE="$GENCODE -gencode arch=compute_$a,code=sm_$a"
    LAST=$a
done
GENCODE="$GENCODE -gencode arch=compute_$LAST,code=compute_$LAST"   # PTX for newer GPUs
echo "arch:      $ARCHS (+PTX $LAST)"

CCBIN="-ccbin $CXX"

# --- test compile
printf '__global__ void k(int*p){p[0]=1;}\nint main(){return 0;}\n' > "$T/t.cu"
if ! "$NVCC" $CCBIN $EXTRA -Wno-deprecated-gpu-targets -gencode arch=compute_$LAST,code=sm_$LAST \
        -o "$T/t" "$T/t.cu" > "$T/log" 2>&1; then
    cat "$T/log" >&2
    echo >&2
    echo "CUDA test compile failed. If the host compiler is not supported, try:" >&2
    echo "  ./configure --host-cxx=g++-10   (or another supported version)" >&2
    echo "  ./configure --allow-unsupported-compiler" >&2
    echo "or build without GPU support: ./configure --without-cuda" >&2
    exit 1
fi

cat > config.mk <<EOF
# generated by ./configure - can be edited by hand
HAVE_CUDA = 1
CXX       = $CXX
CXXFLAGS  = -O3 -std=c++14 -pthread -Wall
CUDA_DIR  = $CUDA_DIR
NVCC      = $NVCC
CCBIN     = $CCBIN
GENCODE   = $GENCODE
NVFLAGS   = -O3 -std=c++14 -Wno-deprecated-gpu-targets $EXTRA
EOF
echo "wrote config.mk. Now run: make && ./vrambw"
